from django.shortcuts import render,get_object_or_404
from .models import Blog ,BlogCategory
from .serializers import BlogSerializer
from rest_framework.renderers import JSONRenderer
from django.http import HttpResponse
from rest_framework.decorators import api_view
from rest_framework.response import Response
from rest_framework import status

# Create your views here.

def blog_list_page(request):
    categories = BlogCategory.objects.filter(is_active=True)
    blogs = Blog.objects.filter(is_active=True)

    return render(request, 'blog_list.html', {
        'blogs': blogs,
        'categories': categories,
        'selected_category': None
    })



def blog_detail_page(request,slug ):
    blog = get_object_or_404(Blog, slug=slug)
    return render(request, 'blog_detail_page.html',{'blog':blog})

def blog_by_category(request, slug):
    categories = BlogCategory.objects.filter(is_active=True)
    category = get_object_or_404(BlogCategory, slug=slug)

    blogs = Blog.objects.filter(category=category, is_active=True)

    return render(request, 'blog_list.html', {
        'blogs': blogs,
        'categories': categories,
        'selected_category': slug
    })



